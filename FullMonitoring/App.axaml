<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FullMonitoring.App"
             xmlns:local="using:FullMonitoring"
             RequestedThemeVariant="Default">
             <!-- Тема "Default" успадковує системну тему. Динамічне перемикання на "Dark" або "Light" підтримується через SettingsViewModel. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Світла тема оформлення з перевіреною контрастністю WCAG 2.1 AA -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#334155" />
                    <SolidColorBrush x:Key="SkeletonPlaceholderBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="InfoBarErrorBackgroundBrush" Color="#FEF2F2" />
                    <SolidColorBrush x:Key="InfoBarWarningBackgroundBrush" Color="#FFFBEB" />
                </ResourceDictionary>

                <!-- Темна тема оформлення з перевіреною контрастністю WCAG 2.1 AA -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#131C31" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#172033" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#334155" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="SkeletonPlaceholderBrush" Color="#334155" />
                    <SolidColorBrush x:Key="InfoBarErrorBackgroundBrush" Color="#2C1519" />
                    <SolidColorBrush x:Key="InfoBarWarningBackgroundBrush" Color="#2B2112" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Колірна палітра системних станів: Нормальний / Попередження / Критичний -->
            <Color x:Key="SystemStateNormalColor">#10B981</Color>
            <Color x:Key="SystemStateWarningColor">#F59E0B</Color>
            <Color x:Key="SystemStateCriticalColor">#EF4444</Color>

            <SolidColorBrush x:Key="SystemStateNormalBrush" Color="{StaticResource SystemStateNormalColor}" />
            <SolidColorBrush x:Key="SystemStateWarningBrush" Color="{StaticResource SystemStateWarningColor}" />
            <SolidColorBrush x:Key="SystemStateCriticalBrush" Color="{StaticResource SystemStateCriticalColor}" />

            <SolidColorBrush x:Key="SystemStateNormalBackgroundBrush" Color="#1A10B981" />
            <SolidColorBrush x:Key="SystemStateWarningBackgroundBrush" Color="#1AF59E0B" />
            <SolidColorBrush x:Key="SystemStateCriticalBackgroundBrush" Color="#1AEF4444" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- Стилі карток та поверхонь із підтримкою динамічної зміни теми Dark / Light -->
        <Style Selector="Border.dashboard-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style Selector="Border.subtle-box">
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="Border.skeleton-block">
            <Setter Property="Background" Value="{DynamicResource SkeletonPlaceholderBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="Border.infobar-error">
            <Setter Property="Background" Value="{DynamicResource InfoBarErrorBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SystemStateCriticalBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style Selector="Border.os-restricted-badge">
            <Setter Property="Background" Value="{StaticResource SystemStateWarningBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SystemStateWarningBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </Application.Styles>
</Application>