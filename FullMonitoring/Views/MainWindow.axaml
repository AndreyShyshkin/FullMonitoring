<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FullMonitoring.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FullMonitoring.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FullMonitoring">

    <Design.DataContext>
        <!-- Це налаштовує DataContext лише для попереднього перегляду в IDE;
             для встановлення реального DataContext під час виконання встановіть властивість DataContext у коді (див. App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <TextBox Text="{Binding Greeting}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" />

</Window>
