<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FullMonitoring.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:Class="FullMonitoring.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="14"
              Margin="4">

            <!-- 1. Налаштування інтервалу опитування телеметрії -->
            <Border Grid.Row="0"
                    Classes="dashboard-card"
                    Padding="18">
                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Інтервал опитування сенсорів"
                                       FontSize="15"
                                       FontWeight="Bold" />
                            <TextBlock Text="Визначає частоту оновлення показників CPU, RAM, дискової підсистеми та мережі"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                CornerRadius="6"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                Background="{StaticResource SystemStateNormalBackgroundBrush}"
                                BorderBrush="{StaticResource SystemStateNormalBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding PollingIntervalFormatted}"
                                       Foreground="{StaticResource SystemStateNormalBrush}"
                                       FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Slider Grid.Row="1"
                            Minimum="250"
                            Maximum="10000"
                            TickFrequency="250"
                            IsSnapToTickEnabled="True"
                            Value="{Binding PollingIntervalMs}" />

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   Text="Швидкий вибір інтервалу (мс):"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailablePollingIntervalsMs}"
                                  SelectedItem="{Binding PollingIntervalMs}"
                                  HorizontalAlignment="Left" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. Налаштування теми оформлення (Світла / Темна / Системна) -->
            <Border Grid.Row="1"
                    Classes="dashboard-card"
                    Padding="18">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Тема оформлення інтерфейсу (Dark / Light)"
                                       FontSize="15"
                                       FontWeight="Bold" />
                            <TextBlock Text="Динамічне перемикання між світлою, темною та системною кольоровою схемою через стилі Avalonia"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="Світла тема (Light)"
                                Command="{Binding SetLightThemeCommand}"
                                Padding="14,8"
                                Margin="0,0,10,6"
                                CornerRadius="6" />
                        <Button Content="Темна тема (Dark)"
                                Command="{Binding SetDarkThemeCommand}"
                                Padding="14,8"
                                Margin="0,0,10,6"
                                CornerRadius="6" />
                        <Button Content="Системна тема"
                                Command="{Binding SetSystemThemeCommand}"
                                Padding="14,8"
                                Margin="0,0,10,6"
                                CornerRadius="6" />
                        <Button Content="Перемкнути Dark / Light"
                                Command="{Binding ToggleThemeCommand}"
                                Padding="14,8"
                                Margin="0,0,0,6"
                                CornerRadius="6" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 3. Довідник колірної палітри системних станів -->
            <Border Grid.Row="2"
                    Classes="dashboard-card"
                    Padding="18">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="12">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="Колірна палітра системних станів (WCAG 2.1 AA)"
                                   FontSize="15"
                                   FontWeight="Bold" />
                        <TextBlock Text="Уніфікована індикація стану навантаження та температур вузлів системи з перевіреною контрастністю"
                                   FontSize="12"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="10">
                        <!-- Нормальний стан -->
                        <Border Grid.Column="0"
                                CornerRadius="8"
                                Padding="12,10"
                                Background="{StaticResource SystemStateNormalBackgroundBrush}"
                                BorderBrush="{StaticResource SystemStateNormalBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Нормальний (#10B981)"
                                           Foreground="{StaticResource SystemStateNormalBrush}"
                                           FontWeight="Bold" />
                                <TextBlock Text="Навантаження &lt; 70% або температура &lt; 70 °C"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.85" />
                            </StackPanel>
                        </Border>

                        <!-- Попередження -->
                        <Border Grid.Column="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Background="{StaticResource SystemStateWarningBackgroundBrush}"
                                BorderBrush="{StaticResource SystemStateWarningBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Попередження (#F59E0B)"
                                           Foreground="{StaticResource SystemStateWarningBrush}"
                                           FontWeight="Bold" />
                                <TextBlock Text="Навантаження 70–89% або температура 70–84 °C"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.85" />
                            </StackPanel>
                        </Border>

                        <!-- Критичний стан -->
                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Padding="12,10"
                                Background="{StaticResource SystemStateCriticalBackgroundBrush}"
                                BorderBrush="{StaticResource SystemStateCriticalBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Критичний (#EF4444)"
                                           Foreground="{StaticResource SystemStateCriticalBrush}"
                                           FontWeight="Bold" />
                                <TextBlock Text="Навантаження ≥ 90% або температура ≥ 85 °C"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.85" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. Порогові сповіщення про критичне навантаження (Issue #8) -->
            <Border Grid.Row="3"
                    Classes="dashboard-card"
                    Padding="18">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="Порогові сповіщення про критичне навантаження"
                                   FontSize="15"
                                   FontWeight="Bold" />
                        <TextBlock Text="Конфігурація граничних лімітів спрацьовування та відстеження тривалості (Issue #8)"
                                   FontSize="12"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*,*,*"
                          ColumnSpacing="10">

                        <!-- Поріг CPU -->
                        <Border Grid.Column="0"
                                Classes="subtle-box"
                                Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Поріг CPU (%)"
                                           FontSize="12"
                                           Opacity="0.85" />
                                <TextBlock Text="{Binding CpuThresholdPercentage, StringFormat='{}{0:F0} %'}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SystemStateCriticalBrush}" />
                                <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding CpuThresholdPercentage}" />
                            </StackPanel>
                        </Border>

                        <!-- Поріг температури -->
                        <Border Grid.Column="1"
                                Classes="subtle-box"
                                Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Поріг темп. (°C)"
                                           FontSize="12"
                                           Opacity="0.85" />
                                <TextBlock Text="{Binding CpuTemperatureThresholdCelsius, StringFormat='{}{0:F0} °C'}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SystemStateCriticalBrush}" />
                                <Slider Minimum="40" Maximum="110" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding CpuTemperatureThresholdCelsius}" />
                            </StackPanel>
                        </Border>

                        <!-- Поріг RAM -->
                        <Border Grid.Column="2"
                                Classes="subtle-box"
                                Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Поріг RAM (%)"
                                           FontSize="12"
                                           Opacity="0.85" />
                                <TextBlock Text="{Binding RamThresholdPercentage, StringFormat='{}{0:F0} %'}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SystemStateCriticalBrush}" />
                                <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding RamThresholdPercentage}" />
                            </StackPanel>
                        </Border>

                        <!-- Тривалість перевантаження -->
                        <Border Grid.Column="3"
                                Classes="subtle-box"
                                Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Тривалість (с)"
                                           FontSize="12"
                                           Opacity="0.85" />
                                <TextBlock Text="{Binding DurationThresholdSeconds, StringFormat='{}{0:F1} с'}"
                                           FontSize="17"
                                           FontWeight="Bold" />
                                <Slider Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding DurationThresholdSeconds}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 5. Нижня панель статусу та скидання налаштувань -->
            <Border Grid.Row="4"
                    Classes="dashboard-card"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               Opacity="0.85"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="Скинути за замовчуванням"
                            Command="{Binding ResetDefaultsCommand}"
                            Padding="12,6"
                            CornerRadius="6" />
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
