<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FullMonitoring.ViewModels"
             xmlns:models="using:FullMonitoring.Models"
             mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="640"
             x:Class="FullMonitoring.Views.EventsLogView"
             x:DataType="vm:EventsLogViewModel">

    <Design.DataContext>
        <vm:EventsLogViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="14"
          Margin="4">

        <!-- Картки статистики подій (Dashboard Cards) -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="12">

            <!-- Всього інцидентів -->
            <Border Grid.Column="0"
                    CornerRadius="10"
                    Padding="14,12"
                    BorderThickness="1"
                    BorderBrush="#26808080"
                    Background="#0D808080">
                <StackPanel Spacing="4">
                    <TextBlock Text="Всього інцидентів"
                               FontSize="12"
                               Opacity="0.7" />
                    <TextBlock Text="{Binding TotalIncidentsCount}"
                               FontSize="22"
                               FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- Критичних інцидентів -->
            <Border Grid.Column="1"
                    CornerRadius="10"
                    Padding="14,12"
                    BorderThickness="1"
                    BorderBrush="{StaticResource SystemStateCriticalBrush}"
                    Background="{StaticResource SystemStateCriticalBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Критичні"
                               FontSize="12"
                               Foreground="{StaticResource SystemStateCriticalBrush}" />
                    <TextBlock Text="{Binding CriticalIncidentsCount}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource SystemStateCriticalBrush}" />
                </StackPanel>
            </Border>

            <!-- Попереджень / Нормалізовано -->
            <Border Grid.Column="2"
                    CornerRadius="10"
                    Padding="14,12"
                    BorderThickness="1"
                    BorderBrush="{StaticResource SystemStateWarningBrush}"
                    Background="{StaticResource SystemStateWarningBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Попередження"
                               FontSize="12"
                               Foreground="{StaticResource SystemStateWarningBrush}" />
                    <TextBlock Text="{Binding WarningIncidentsCount}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource SystemStateWarningBrush}" />
                </StackPanel>
            </Border>

            <!-- Активні перевантаження -->
            <Border Grid.Column="3"
                    CornerRadius="10"
                    Padding="14,12"
                    BorderThickness="1"
                    BorderBrush="#26808080"
                    Background="#0D808080">
                <StackPanel Spacing="4">
                    <TextBlock Text="Активні перевантаження"
                               FontSize="12"
                               Opacity="0.7" />
                    <TextBlock Text="{Binding ActiveOverloadsCount}"
                               FontSize="22"
                               FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Панель фільтрації та дій -->
        <Border Grid.Row="1"
                CornerRadius="10"
                Padding="14,10"
                BorderThickness="1"
                BorderBrush="#26808080"
                Background="#0D808080">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="10">

                <TextBlock Grid.Column="0"
                           Text="Фільтр метрик:"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Opacity="0.8" />

                <!-- Кнопки швидкого фільтра -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="Всі"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Всі"
                            Padding="12,5"
                            CornerRadius="6"
                            FontSize="12" />
                    <Button Content="CPU"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="CPU"
                            Padding="12,5"
                            CornerRadius="6"
                            FontSize="12" />
                    <Button Content="Температура"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Температура"
                            Padding="12,5"
                            CornerRadius="6"
                            FontSize="12" />
                    <Button Content="RAM"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="RAM"
                            Padding="12,5"
                            CornerRadius="6"
                            FontSize="12" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Оновити журнал"
                        Command="{Binding RefreshLogCommand}"
                        Padding="14,6"
                        CornerRadius="6"
                        FontSize="12" />

                <Button Grid.Column="3"
                        Content="Очистити журнал"
                        Command="{Binding ClearLogCommand}"
                        Background="{StaticResource SystemStateCriticalBackgroundBrush}"
                        Foreground="{StaticResource SystemStateCriticalBrush}"
                        BorderBrush="{StaticResource SystemStateCriticalBrush}"
                        BorderThickness="1"
                        Padding="14,6"
                        CornerRadius="6"
                        FontSize="12" />
            </Grid>
        </Border>

        <!-- Список зафіксованих інцидентів -->
        <Border Grid.Row="2"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="#26808080"
                Background="#0A808080"
                ClipToBounds="True">
            <Grid>
                <!-- Якщо список порожній -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            IsVisible="{Binding !HasIncidents}">
                    <TextBlock Text="Журнал подій порожній"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Opacity="0.7" />
                    <TextBlock Text="Перевищень порогових значень навантаження чи температури не зафіксовано."
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Opacity="0.5" />
                </StackPanel>

                <!-- Список подій -->
                <ListBox ItemsSource="{Binding Incidents}"
                         IsVisible="{Binding HasIncidents}"
                         Background="Transparent"
                         Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:AlertIncident">
                            <Border Margin="0,3"
                                    Padding="14,10"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="#1F808080"
                                    Background="#08808080">
                                <Grid ColumnDefinitions="140,160,*,120"
                                      ColumnSpacing="14"
                                      VerticalAlignment="Center">

                                    <!-- Часова мітка -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedTimestamp}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.9" />
                                    </StackPanel>

                                    <!-- Назва метрики та значення -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding MetricDisplayName}"
                                                   FontSize="12"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding FormattedActualValue, StringFormat='Факт: {0}'}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SystemStateCriticalBrush}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>

                                    <!-- Деталі повідомлення -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Message}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding FormattedThresholdValue, StringFormat='Встановлений поріг: {0}'}"
                                                   FontSize="11"
                                                   Opacity="0.6" />
                                    </StackPanel>

                                    <!-- Тривалість -->
                                    <StackPanel Grid.Column="3"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <Border CornerRadius="6"
                                                Padding="8,3"
                                                Background="#14808080"
                                                BorderBrush="#26808080"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding FormattedDuration, StringFormat='Тривав {0}'}"
                                                       FontSize="11"
                                                       Opacity="0.8" />
                                        </Border>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Нижня інформаційна панель стану -->
        <Border Grid.Row="3"
                CornerRadius="8"
                Padding="12,8"
                BorderThickness="1"
                BorderBrush="#1F808080"
                Background="#08808080">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Opacity="0.75" />
        </Border>

    </Grid>
</UserControl>
