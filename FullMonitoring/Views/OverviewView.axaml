<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FullMonitoring.ViewModels"
             xmlns:models="using:FullMonitoring.Models"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:Class="FullMonitoring.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

    <Design.DataContext>
        <vm:OverviewViewModel />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="14"
              Margin="4">

            <!-- Верхня інформаційна панель стану вузла -->
            <Border Grid.Row="0"
                    Classes="dashboard-card"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <WrapPanel Grid.Column="0"
                               Orientation="Horizontal"
                               VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,16,2">
                            <TextBlock Text="Вузол:" Opacity="0.7" />
                            <TextBlock Text="{Binding MachineName}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,16,2">
                            <TextBlock Text="ОС:" Opacity="0.7" />
                            <TextBlock Text="{Binding OsDescription}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,16,2">
                            <TextBlock Text="Архітектура:" Opacity="0.7" />
                            <TextBlock Text="{Binding Architecture}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,16,2">
                            <TextBlock Text="Аптайм:" Opacity="0.7" />
                            <TextBlock Text="{Binding UptimeFormatted}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,12,2">
                            <TextBlock Text="Джерело:" Opacity="0.7" />
                            <TextBlock Text="{Binding ProviderName}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Classes="os-restricted-badge"
                                IsVisible="{Binding HasRestrictedMetrics}"
                                ToolTip.Tip="{Binding OsSecurityRestrictionText}"
                                Margin="0,2,0,2">
                            <TextBlock Text="🔒 Заблоковано політикою безпеки ОС"
                                       Foreground="{StaticResource SystemStateWarningBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </WrapPanel>

                    <WrapPanel Grid.Column="1"
                               Orientation="Horizontal"
                               VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastUpdatedFormatted}"
                                   VerticalAlignment="Center"
                                   Opacity="0.75"
                                   FontSize="12"
                                   Margin="0,0,10,0" />
                        <Button Content="Оновити метрики"
                                Command="{Binding RefreshMetricsCommand}"
                                Padding="12,6"
                                CornerRadius="6" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Індикатор первинного завантаження (Skeleton / Spinner), поки триває перший збір метрик при старті програми (Issue #11) -->
            <Border Grid.Row="1"
                    Classes="dashboard-card"
                    Padding="18,16"
                    IsVisible="{Binding IsInitialLoading}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Первинний збір системних метрик..."
                                       FontSize="15"
                                       FontWeight="Bold" />
                            <TextBlock Text="Ініціалізація сенсорів CPU, RAM, накопичувачів та мережевих адаптерів"
                                       FontSize="12"
                                       Opacity="0.7" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="Завантаження..."
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SystemStateNormalBrush}" />
                    </Grid>

                    <!-- Індикатор Spinner / Indeterminate ProgressBar -->
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 CornerRadius="3"
                                 Foreground="{StaticResource SystemStateNormalBrush}" />

                    <!-- Skeleton-макет карток -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Classes="subtle-box" Padding="12">
                            <StackPanel Spacing="8">
                                <Border Classes="skeleton-block" Height="16" Width="140" HorizontalAlignment="Left" />
                                <Border Classes="skeleton-block" Height="28" Width="90" HorizontalAlignment="Left" />
                                <Border Classes="skeleton-block" Height="80" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="subtle-box" Padding="12">
                            <StackPanel Spacing="8">
                                <Border Classes="skeleton-block" Height="16" Width="140" HorizontalAlignment="Left" />
                                <Border Classes="skeleton-block" Height="28" Width="90" HorizontalAlignment="Left" />
                                <Border Classes="skeleton-block" Height="80" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Адаптивна сітка зведених карток 2x2: CPU, RAM, Disk, Network -->
            <Grid Grid.Row="2"
                  RowDefinitions="*,*"
                  ColumnDefinitions="*,*"
                  RowSpacing="14"
                  ColumnSpacing="14"
                  IsVisible="{Binding !IsInitialLoading}">

                <!-- 1. Картка CPU + Графік динаміки за 60 секунд -->
                <Border Grid.Row="0" Grid.Column="0"
                        Classes="dashboard-card"
                        Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                          RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Центральний процесор (CPU)"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Динаміка утилізації за останні 60 секунд та термодатчики"
                                           FontSize="11"
                                           Opacity="0.7"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    VerticalAlignment="Top"
                                    Background="{Binding CpuStateBackgroundBrush}"
                                    BorderBrush="{Binding CpuStateBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding CpuStateLabel}"
                                           Foreground="{Binding CpuStateBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding CpuUsageFormatted}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{Binding CpuStateBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CpuCoreCount, StringFormat='Логічних ядер: {0}'}"
                                       VerticalAlignment="Bottom"
                                       FontSize="12"
                                       Opacity="0.8" />
                        </Grid>

                        <ProgressBar Grid.Row="2"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding CpuUsagePercentage}"
                                     Foreground="{Binding CpuStateBrush}"
                                     CornerRadius="4" />

                        <!-- Лінійний графік динаміки навантаження CPU за останні 60 секунд (LiveCharts2) -->
                        <Border Grid.Row="3"
                                Classes="subtle-box"
                                Padding="8,6"
                                MinHeight="125">
                            <Grid RowDefinitions="Auto,*" RowSpacing="4">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="Історія завантаження CPU (60 с)"
                                               FontSize="11"
                                               Opacity="0.75" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CpuUsageHistory.Count, StringFormat='Точок: {0}/60'}"
                                               FontSize="11"
                                               Opacity="0.65" />
                                </Grid>
                                <lvc:CartesianChart Grid.Row="1"
                                                    Series="{Binding CpuSeries}"
                                                    XAxes="{Binding CpuXAxes}"
                                                    YAxes="{Binding CpuYAxes}"
                                                    TooltipPosition="Hidden"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />
                            </Grid>
                        </Border>

                        <!-- Блок термодатчиків із візуальними підказками "Заблоковано політикою безпеки ОС" (Issue #11) -->
                        <Grid Grid.Row="4"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="10"
                              VerticalAlignment="Bottom">
                            <Border Grid.Column="0"
                                    Classes="subtle-box"
                                    Padding="10,7"
                                    ToolTip.Tip="{Binding CpuTemperatureRestrictionTooltip}">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0"
                                                   Text="Температура CPU"
                                                   FontSize="11"
                                                   Opacity="0.75"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1"
                                                Classes="os-restricted-badge"
                                                IsVisible="{Binding IsCpuTemperatureRestricted}"
                                                ToolTip.Tip="{Binding OsSecurityRestrictionText}">
                                            <TextBlock Text="🔒 ОС"
                                                       Foreground="{StaticResource SystemStateWarningBrush}"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding CpuTemperatureFormatted}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OsSecurityRestrictionText}"
                                               IsVisible="{Binding IsCpuTemperatureRestricted}"
                                               Foreground="{StaticResource SystemStateWarningBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Classes="subtle-box"
                                    Padding="10,7"
                                    ToolTip.Tip="{Binding CpuFanSpeedRestrictionTooltip}">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0"
                                                   Text="Оберти кулера"
                                                   FontSize="11"
                                                   Opacity="0.75"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1"
                                                Classes="os-restricted-badge"
                                                IsVisible="{Binding IsCpuFanSpeedRestricted}"
                                                ToolTip.Tip="{Binding OsSecurityRestrictionText}">
                                            <TextBlock Text="🔒 ОС"
                                                       Foreground="{StaticResource SystemStateWarningBrush}"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding CpuFanSpeedFormatted}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OsSecurityRestrictionText}"
                                               IsVisible="{Binding IsCpuFanSpeedRestricted}"
                                               Foreground="{StaticResource SystemStateWarningBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. Картка RAM + Кругова діаграма та прогрес-бар розподілу пам'яті -->
                <Border Grid.Row="0" Grid.Column="1"
                        Classes="dashboard-card"
                        Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                          RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Оперативна пам'ять (RAM)"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Розподіл фізичної пам'яті системи у реальному часі"
                                           FontSize="11"
                                           Opacity="0.7"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    VerticalAlignment="Top"
                                    Background="{Binding RamStateBackgroundBrush}"
                                    BorderBrush="{Binding RamStateBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding RamStateLabel}"
                                           Foreground="{Binding RamStateBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding RamUsageFormatted}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{Binding RamStateBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RamTotalFormatted, StringFormat='Всього: {0}'}"
                                       VerticalAlignment="Bottom"
                                       FontSize="12"
                                       Opacity="0.8" />
                        </Grid>

                        <!-- Горизонтальний прогрес-бар заповнення RAM -->
                        <ProgressBar Grid.Row="2"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding RamUsagePercentage}"
                                     Foreground="{Binding RamStateBrush}"
                                     CornerRadius="4" />

                        <!-- Кругова діаграма (Donut Chart) розподілу пам'яті RAM (LiveCharts2) -->
                        <Border Grid.Row="3"
                                Classes="subtle-box"
                                Padding="10,8"
                                MinHeight="125">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <lvc:PieChart Grid.Column="0"
                                              Series="{Binding RamSeries}"
                                              InitialRotation="-90"
                                              TooltipPosition="Hidden"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                    <TextBlock Text="Структура пам'яті"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Opacity="0.85" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Зайнята частка:" FontSize="11" Opacity="0.7" />
                                        <TextBlock Text="{Binding RamUsageFormatted}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding RamStateBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Доступний резерв:" FontSize="11" Opacity="0.7" />
                                        <TextBlock Text="{Binding RamFreeFormatted}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="10"
                              VerticalAlignment="Bottom">
                            <Border Grid.Column="0"
                                    Classes="subtle-box"
                                    Padding="10,7">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Використано" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding RamUsedFormatted}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Classes="subtle-box"
                                    Padding="10,7">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Вільно" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding RamFreeFormatted}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. Картка Disk -->
                <Border Grid.Row="1" Grid.Column="0"
                        Classes="dashboard-card"
                        Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto,*"
                          RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Дискова підсистема (Disk)"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Стан змонтованих накопичувачів та томів"
                                           FontSize="11"
                                           Opacity="0.7"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    VerticalAlignment="Top"
                                    Background="{Binding DiskStateBackgroundBrush}"
                                    BorderBrush="{Binding DiskStateBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding DiskStateLabel}"
                                           Foreground="{Binding DiskStateBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DiskUsageFormatted}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{Binding DiskStateBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActiveDrivesCount, StringFormat='Активних томів: {0}'}"
                                       VerticalAlignment="Bottom"
                                       FontSize="12"
                                       Opacity="0.8" />
                        </Grid>

                        <ProgressBar Grid.Row="2"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding DiskUsagePercentage}"
                                     Foreground="{Binding DiskStateBrush}"
                                     CornerRadius="4" />

                        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">
                            <WrapPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding DiskUsedFormatted, StringFormat='Зайнято: {0}'}" FontSize="11" Opacity="0.85" Margin="0,0,12,2" />
                                <TextBlock Text="{Binding DiskFreeFormatted, StringFormat='Вільно: {0}'}" FontSize="11" Opacity="0.85" Margin="0,0,12,2" />
                                <TextBlock Text="{Binding DiskTotalFormatted, StringFormat='Обсяг: {0}'}" FontSize="11" Opacity="0.85" Margin="0,0,0,2" />
                            </WrapPanel>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DriveItemMetrics">
                                        <Border Classes="subtle-box"
                                                Padding="8,5"
                                                Margin="0,2">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding DriveFormat, StringFormat='({0})'}" Opacity="0.7" />
                                                <TextBlock Grid.Column="2" Text="{Binding UsedPercentage, StringFormat='{}{0:F1} %'}" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 4. Картка Network -->
                <Border Grid.Row="1" Grid.Column="1"
                        Classes="dashboard-card"
                        Padding="16">
                    <Grid RowDefinitions="Auto,Auto,*"
                          RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Мережеві інтерфейси (Network)"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Поточна пропускна здатність та трафік RX/TX"
                                           FontSize="11"
                                           Opacity="0.7"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    VerticalAlignment="Top"
                                    Background="{Binding NetworkStateBackgroundBrush}"
                                    BorderBrush="{Binding NetworkStateBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding NetworkStateLabel}"
                                           Foreground="{Binding NetworkStateBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    Classes="subtle-box"
                                    Padding="10,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Приймання (RX)" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding NetworkRxSpeedFormatted}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{Binding NetworkStateBrush}" />
                                    <TextBlock Text="{Binding NetworkTotalRxFormatted, StringFormat='Всього: {0}'}"
                                               FontSize="11"
                                               Opacity="0.75" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Classes="subtle-box"
                                    Padding="10,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Відправлення (TX)" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding NetworkTxSpeedFormatted}"
                                               FontSize="18"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding NetworkTotalTxFormatted, StringFormat='Всього: {0}'}"
                                               FontSize="11"
                                               Opacity="0.75" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
                            <TextBlock Grid.Row="0"
                                       Text="{Binding ActiveInterfacesCount, StringFormat='Мережеві адаптери ({0}):'}"
                                       FontSize="12"
                                       Opacity="0.8" />

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding NetworkInterfaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:NetworkInterfaceMetrics">
                                        <Border Classes="subtle-box"
                                                Padding="8,5"
                                                Margin="0,2">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding InterfaceType}" Opacity="0.7" FontSize="12" />
                                                <TextBlock Grid.Column="2" Text="{Binding OperationalStatus}" FontWeight="SemiBold" FontSize="12" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
