<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FullMonitoring.ViewModels"
             xmlns:models="using:FullMonitoring.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:Class="FullMonitoring.Views.ProcessesView"
             x:DataType="vm:ProcessesViewModel">

    <Design.DataContext>
        <vm:ProcessesViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="12"
          Margin="4">

        <!-- Панель пошуку та керування процесами -->
        <Border Grid.Row="0"
                Classes="dashboard-card"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="10">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery}"
                         PlaceholderText="Пошук за назвою процесу або PID..."
                         VerticalContentAlignment="Center" />

                <Button Grid.Column="1"
                        Content="Оновити список"
                        Command="{Binding RefreshProcessesCommand}"
                        Padding="12,6"
                        CornerRadius="6" />

                <Button Grid.Column="2"
                        Content="Експорт ▾"
                        Padding="12,6"
                        CornerRadius="6"
                        ToolTip.Tip="Експортувати список процесів у CSV або JSON">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Експорт у CSV (Excel)"
                                      Command="{Binding ExportToCsvCommand}" />
                            <MenuItem Header="Експорт у JSON"
                                      Command="{Binding ExportToJsonCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button Grid.Column="3"
                        Content="Завершити процес"
                        Command="{Binding KillSelectedProcessCommand}"
                        Background="{StaticResource SystemStateCriticalBackgroundBrush}"
                        Foreground="{StaticResource SystemStateCriticalBrush}"
                        BorderBrush="{StaticResource SystemStateCriticalBrush}"
                        BorderThickness="1"
                        Padding="12,6"
                        CornerRadius="6" />
            </Grid>
        </Border>

        <!-- Ненав'язливий компонент InfoBar для помилок провайдера або обмеження прав ОС (Issue #11) -->
        <StackPanel Grid.Row="1" Spacing="8">
            <Border Classes="infobar-error"
                    IsVisible="{Binding HasProviderError}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0"
                               Text="InfoBar:"
                               Foreground="{StaticResource SystemStateCriticalBrush}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProviderErrorMessage}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="Закрити"
                            Command="{Binding DismissProviderErrorCommand}"
                            Padding="10,4"
                            CornerRadius="6"
                            FontSize="11" />
                </Grid>
            </Border>

            <Border Classes="os-restricted-badge"
                    Padding="12,8"
                    IsVisible="{Binding IsLastActionRestrictedByOs}"
                    ToolTip.Tip="{Binding OsSecurityRestrictionText}">
                <TextBlock Text="🔒 Заблоковано політикою безпеки ОС — для завершення системного процесу потрібні підвищені привілеї."
                           Foreground="{StaticResource SystemStateWarningBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         IsVisible="{Binding IsInitialLoading}"
                         Foreground="{StaticResource SystemStateNormalBrush}" />
        </StackPanel>

        <!-- Таблиця процесів із пропорційними колонками без фіксованих розмірів -->
        <Border Grid.Row="2"
                Classes="dashboard-card"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">

                <!-- Заголовок таблиці -->
                <Border Grid.Row="0"
                        Padding="16,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Background="{DynamicResource SubtleSurfaceBrush}">
                    <Grid ColumnDefinitions="1*,3*,2*,1*,2*"
                          ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="PID" FontWeight="Bold" Opacity="0.85" />
                        <TextBlock Grid.Column="1" Text="Назва процесу" FontWeight="Bold" Opacity="0.85" />
                        <TextBlock Grid.Column="2" Text="Пам'ять (RAM)" FontWeight="Bold" Opacity="0.85" />
                        <TextBlock Grid.Column="3" Text="Потоки" FontWeight="Bold" Opacity="0.85" />
                        <TextBlock Grid.Column="4" Text="Статус" FontWeight="Bold" Opacity="0.85" />
                    </Grid>
                </Border>

                <!-- Список рядків таблиці -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Processes}"
                         SelectedItem="{Binding SelectedProcess}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ProcessItem">
                            <Grid ColumnDefinitions="1*,3*,2*,1*,2*"
                                  ColumnSpacing="12"
                                  Margin="4,2">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Pid}"
                                           VerticalAlignment="Center"
                                           Opacity="0.85" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RamUsageMb, StringFormat='{}{0:F2} МБ'}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding ThreadCount}"
                                           VerticalAlignment="Center"
                                           Opacity="0.85" />
                                <Border Grid.Column="4"
                                        CornerRadius="5"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SystemStateNormalBackgroundBrush}"
                                        BorderBrush="{StaticResource SystemStateNormalBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{StaticResource SystemStateNormalBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Нижня інформаційна панель таблиці процесів -->
        <Border Grid.Row="3"
                Classes="dashboard-card"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Opacity="0.85"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalProcessesCount, StringFormat='Відображено: {0}'}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalRamUsageFormatted, StringFormat='Сумарна RAM вибірки: {0}'}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
