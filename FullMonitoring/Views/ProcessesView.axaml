<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.com/markup-compatibility/2006"
             xmlns:vm="using:FullMonitoring.ViewModels"
             xmlns:models="using:FullMonitoring.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:Class="FullMonitoring.Views.ProcessesView"
             x:DataType="vm:ProcessesViewModel">

    <Design.DataContext>
        <vm:ProcessesViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="14"
          Margin="4">

        <!-- Панель пошуку та керування процесами -->
        <Border Grid.Row="0"
                CornerRadius="10"
                Padding="14,12"
                BorderThickness="1"
                BorderBrush="#26808080"
                Background="#0D808080">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="12">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery}"
                         Watermark="Пошук за назвою процесу або PID..."
                         VerticalContentAlignment="Center" />

                <Button Grid.Column="1"
                        Content="Оновити список"
                        Command="{Binding RefreshProcessesCommand}"
                        Padding="14,7"
                        CornerRadius="6" />

                <Button Grid.Column="2"
                        Content="Завершити процес"
                        Command="{Binding KillSelectedProcessCommand}"
                        Background="{StaticResource SystemStateCriticalBackgroundBrush}"
                        Foreground="{StaticResource SystemStateCriticalBrush}"
                        BorderBrush="{StaticResource SystemStateCriticalBrush}"
                        BorderThickness="1"
                        Padding="14,7"
                        CornerRadius="6" />
            </Grid>
        </Border>

        <!-- Таблиця процесів із пропорційними колонками без фіксованих розмірів -->
        <Border Grid.Row="1"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="#26808080"
                Background="#0A808080"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">

                <!-- Заголовок таблиці -->
                <Border Grid.Row="0"
                        Padding="16,12"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#26808080"
                        Background="#14808080">
                    <Grid ColumnDefinitions="1*,3*,2*,1*,2*"
                          ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="PID" FontWeight="Bold" Opacity="0.8" />
                        <TextBlock Grid.Column="1" Text="Назва процесу" FontWeight="Bold" Opacity="0.8" />
                        <TextBlock Grid.Column="2" Text="Пам'ять (RAM)" FontWeight="Bold" Opacity="0.8" />
                        <TextBlock Grid.Column="3" Text="Потоки" FontWeight="Bold" Opacity="0.8" />
                        <TextBlock Grid.Column="4" Text="Статус" FontWeight="Bold" Opacity="0.8" />
                    </Grid>
                </Border>

                <!-- Список рядків таблиці -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Processes}"
                         SelectedItem="{Binding SelectedProcess}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ProcessItem">
                            <Grid ColumnDefinitions="1*,3*,2*,1*,2*"
                                  ColumnSpacing="12"
                                  Margin="4,2">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Pid}"
                                           VerticalAlignment="Center"
                                           Opacity="0.8" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RamUsageMb, StringFormat='{}{0:F2} МБ'}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding ThreadCount}"
                                           VerticalAlignment="Center"
                                           Opacity="0.85" />
                                <Border Grid.Column="4"
                                        CornerRadius="5"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SystemStateNormalBackgroundBrush}"
                                        BorderBrush="{StaticResource SystemStateNormalBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{StaticResource SystemStateNormalBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Нижня інформаційна панель таблиці процесів -->
        <Border Grid.Row="2"
                CornerRadius="8"
                Padding="14,10"
                BorderThickness="1"
                BorderBrush="#26808080"
                Background="#0D808080">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Opacity="0.8"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalProcessesCount, StringFormat='Відображено: {0}'}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalRamUsageFormatted, StringFormat='Сумарна RAM вибірки: {0}'}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
